<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Darkhall" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/darkroom</item>
        <item name="android:statusBarColor">@color/darkroom</item>
        <item name="android:navigationBarColor">@color/darkroom</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme: the splash screen, then Theme.Darkhall. Android 12+ animates the mark
         (values-v31); older versions show it still. -->
    <style name="Theme.Darkhall.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/darkroom</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Darkhall</item>
    </style>
</resources>
