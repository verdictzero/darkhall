<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon (Android 12+): the chevrons light up from the nearest to the farthest, like
     lights coming on down a vaulted hall. 900 ms in all (Splash.ICON_MS). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_chevrons">
    <target android:name="c0l">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="trimPathEnd"
                    android:startOffset="480"
                    android:duration="420"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:startOffset="480"
                    android:duration="420"
                    android:valueFrom="0"
                    android:valueTo="0.26"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/linear_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
