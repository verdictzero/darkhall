<?xml version="1.0" encoding="utf-8"?>
<!-- Export dialog, progress pill, export notifications and the editor's messages. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Export dialog -->
    <!-- The count is never 0 (an export or share always has a photo), so "one" means just 1. -->
    <plurals name="export_dialog_title" tools:ignore="ImpliedQuantity">
        <item quantity="one">Exportar</item>
        <item quantity="many">Exportar %1$d fotos</item>
        <item quantity="other">Exportar %1$d fotos</item>
    </plurals>
    <string name="export_format">Formato</string>
    <string name="export_purpose_jpeg">Arquivos pequenos. 8 bits.</string>
    <string name="export_purpose_png">Sem perdas. Até 16 bits.</string>
    <string name="export_purpose_tiff">Sem perdas. Até 16 bits. Mantém EXIF e GPS.</string>
    <string name="export_purpose_webp">Sem perdas, menor que PNG. 8 bits.</string>
    <string name="export_purpose_tga">8 bits. Sem EXIF.</string>
    <string name="export_quality">Qualidade</string>
    <string name="export_bit_depth">Profundidade de bits</string>
    <string name="export_8_bit">8 bits</string>
    <string name="export_16_bit">16 bits</string>
    <string name="export_compression">Compressão</string>
    <!-- No TIFF compression -->
    <string name="export_compression_none">Nenhuma</string>
    <string name="export_size">Tamanho (lado maior)</string>
    <!-- Export at the photo's full size -->
    <string name="export_size_full">Original</string>
    <string name="export_size_px">%1$d px</string>
    <string name="export_start">Iniciar exportação</string>
    <string name="export_cancel">Cancelar</string>

    <!-- Progress pill -->
    <string name="export_progress_of">Exportando %1$d de %2$d · %3$d%%</string>
    <string name="export_progress">Exportando · %1$d%%</string>
    <!-- %2$s is the folder, e.g. Pictures/Darkhall -->
    <plurals name="export_saved_photos">
        <item quantity="one">%1$d foto salva em %2$s</item>
        <item quantity="many">%1$d fotos salvas em %2$s</item>
        <item quantity="other">%1$d fotos salvas em %2$s</item>
    </plurals>
    <string name="export_failed">Falha na exportação</string>
    <!-- %1$s lists the files that failed -->
    <string name="export_failed_names">Falha na exportação: %1$s</string>
    <string name="export_saved_failed">%1$d salvas, %2$d com falha</string>
    <string name="export_saved_failed_names">%1$d salvas, %2$d com falha: %3$s</string>
    <string name="export_share">Compartilhar</string>
    <plurals name="export_share_chooser" tools:ignore="ImpliedQuantity">
        <item quantity="one">Compartilhar foto</item>
        <item quantity="many">Compartilhar %1$d fotos</item>
        <item quantity="other">Compartilhar %1$d fotos</item>
    </plurals>

    <!-- Export notification and results -->
    <string name="export_channel">Exportações</string>
    <string name="export_notification_of">Exportando %1$d de %2$d</string>
    <string name="export_notification">Exportando</string>
    <string name="export_preparing">Preparando…</string>
    <!-- Stands in for a file name that could not be read -->
    <string name="export_default_name">foto</string>
    <string name="export_focus_stack">Empilhamento de foco · %1$s</string>
    <!-- %2$s is the reason -->
    <string name="export_focus_stack_failed">empilhamento de foco de %1$s (%2$s)</string>
    <string name="export_stack_different_size">%1$s tem outro tamanho</string>
    <string name="export_job_missing">a lista de arquivos da exportação não foi encontrada</string>

    <!-- Editor messages -->
    <string name="develop_render_failed">Falha na renderização: %1$s</string>
    <string name="develop_out_of_memory">Memória insuficiente para abrir este arquivo.</string>
    <!-- Appended to the photo's description; the two leading spaces are kept -->
    <string name="develop_info_noise">"%1$s  ruído ≈ ISO %2$d"</string>
    <string name="develop_gpu_stopped">Renderização na GPU interrompida; usando a CPU</string>
    <string name="develop_gpu_off">Desativada</string>
    <string name="develop_gpu_unavailable">Indisponível</string>
    <string name="develop_gpu_rejected">Desativada: não coincidiu com a CPU neste driver</string>
    <!-- %1$s is a technical measure of the difference -->
    <string name="develop_gpu_mismatch">Desativada: não coincidiu com a CPU (%1$s)</string>
    <string name="develop_gpu_mismatch_message">A GPU difere da CPU; usando a CPU</string>
    <string name="develop_gpu_error">Erro da GPU</string>
    <!-- %1$s lists the changed sliders, or says nothing changed -->
    <string name="develop_auto">Auto: %1$s</string>
    <string name="develop_auto_balanced">já está equilibrada</string>
    <!-- A slider and its new value, e.g. Exposure +0.50 -->
    <string name="develop_auto_change">%1$s %2$s</string>
    <string name="develop_masks_failed">Falha na detecção de áreas: %1$s</string>
    <string name="develop_no_lines">Nenhum horizonte ou linha vertical encontrado</string>
    <!-- Straighten messages: %1$s is develop_source_auto or develop_source_level -->
    <string name="develop_source_auto">Auto</string>
    <string name="develop_source_level">Nível</string>
    <string name="develop_already_level">%1$s: já está nivelada</string>
    <!-- %2$s is the Straighten value, %3$s the tilt in degrees -->
    <string name="develop_straighten_limit">%1$s: Endireitar %2$s (o máximo possível; a linha está %3$s° fora)</string>
    <!-- %3$s says how it was levelled, e.g. from the horizon -->
    <string name="develop_straighten">%1$s: Endireitar %2$s %3$s</string>
    <string name="develop_by_verticals">pelas linhas verticais</string>
    <string name="develop_by_horizon">pelo horizonte</string>
    <string name="develop_to_level">para nivelar</string>
    <string name="develop_to_upright">para aprumar</string>
    <string name="develop_settings_copied">Configurações copiadas</string>
    <string name="develop_settings_pasted">Ajustes colados</string>
    <string name="develop_preset_saved">Predefinição \"%1$s\" salva</string>
    <string name="develop_preset_applied">\"%1$s\" aplicada</string>
    <string name="develop_export_started">Exportação iniciada</string>
</resources>
